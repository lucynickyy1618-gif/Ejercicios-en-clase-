#include <stdio.h>

#define NUM_APARATOS 10
#define NUM_COMPONENTES 100

int main() {
    // Matriz para registrar qué componentes tiene cada aparato (índices del 1 al 100)
    int usa_componente[NUM_APARATOS][NUM_COMPONENTES + 1] = {0};
    int num_comp_aparato[NUM_APARATOS];
    int produccion_mensual[NUM_APARATOS];
    int total_componentes[NUM_COMPONENTES + 1] = {0};

    printf("====================================================\n");
    printf("   SISTEMA DE CONTROL DE COMPONENTES ELECTRONICOS   \n");
    printf("====================================================\n\n");

    // 1. Lectura de los componentes de cada aparato electrónico
    printf("--- PASO 1: Registro de componentes por aparato ---\n");
    for (int i = 0; i < NUM_APARATOS; i++) {
        printf("\nAparato %d:\n", i + 1);
        printf("  Numero de componentes que tiene este aparato: ");
        scanf("%d", &num_comp_aparato[i]);
        
        printf("  Ingrese los identificadores de los componentes (del 1 al 100):\n");
        for (int j = 0; j < num_comp_aparato[i]; j++) {
            int comp;
            printf("    Componente %d: ", j + 1);
            scanf("%d", &comp);
            
            if (comp >= 1 && comp <= NUM_COMPONENTES) {
                usa_componente[i][comp] = 1;
            } else {
                printf("    [Error] Componente fuera de rango (1-100). Ingrese de nuevo.\n");
                j--; // Repetir esta iteración
            }
        }
    }

    // 2. Lectura del número de unidades que se montan mensualmente de cada aparato
    printf("\n--- PASO 2: Produccion mensual de aparatos ---\n");
    for (int i = 0; i < NUM_APARATOS; i++) {
        printf("  Unidades montadas al mes del Aparato %d: ", i + 1);
        scanf("%d", &produccion_mensual[i]);
    }

    // 3. Contabilizar el número de componentes que se necesitan cada mes
    for (int i = 0; i < NUM_APARATOS; i++) {
        for (int c = 1; c <= NUM_COMPONENTES; c++) {
            if (usa_componente[i][c] == 1) {
                total_componentes[c] += produccion_mensual[i];
            }
        }
    }

    // Mostrar en pantalla el requerimiento mensual por componente
    printf("\n--- PASO 3: Cantidad total necesaria de cada componente al mes ---\n");
    for (int c = 1; c <= NUM_COMPONENTES; c++) {
        printf("Componente #%3d : %6d unidades requeridas\n", c, total_componentes[c]);
    }

    // 4. Identificar el componente eléctrico que más se utiliza
    int max_uso = -1;
    int comp_mas_utilizado = -1;
    
    for (int c = 1; c <= NUM_COMPONENTES; c++) {
        if (total_componentes[c] > max_uso) {
            max_uso = total_componentes[c];
            comp_mas_utilizado = c;
        }
    }

    // Resultado final
    printf("\n====================================================\n");
    printf("                  RESULTADO FINAL                   \n");
    printf("====================================================\n");
    printf(" El componente electrico que MAS se utiliza es el\n");
    printf(" Componente #%d con un total de %d unidades al mes.\n", comp_mas_utilizado, max_uso);
    printf("====================================================\n");

    return 0;
}
